# Copy this file to .env and fill in real values before running
# `docker compose up --build`. Never commit the real .env file.

# Postgres password shared by the postgres and backend services.
POSTGRES_PASSWORD=

# JWT signing secret. Generate one with: openssl rand -base64 48
APP_JWT_SECRET=

# Comma-separated list of frontend origins allowed to call the API.
APP_CORS_ALLOWED_ORIGINS=http://localhost:8081

# Base URL the frontend is built to call. Must be reachable from the
# browser (not the "backend" service name, which only resolves inside
# the Docker network).
VITE_API_URL=http://localhost:8080
